<% layout("layouts/boilerplate") %> <!--This layout function searches for file directly in a views folder hence dont start normally by ./ or ../ as we do in require function-->

<body>
    <h3>All Listings</h3>
    <form method="GET" action="/listings/new">
      <button>Create New Listing</button>
    </form>
    <ul>
      <% for(let listing of allListings) { %>
      <li><a href="/listings/<%= listing._id %>"> <%= listing.title %> </a></li>
      <% } %>
    </ul>
</body>